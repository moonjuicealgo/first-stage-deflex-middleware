{
  "name": "first-stage-deflex-middleware",
  "version": "2.0.1",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE.md"
  ],
  "scripts": {
    "test-mainnet": "node -r ts-node/register tests/mainnetMiddlewareTest.ts",
    "test-testnet": "node -r ts-node/register tests/testnetBuyTaxTest.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/finish-build.mjs"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.2"
  },
  "peerDependencies": {
    "@txnlab/deflex": "^1.3.0",
    "algosdk": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonjuicealgo/first-stage-deflex-middleware.git"
  },
  "keywords": [
    "algorand",
    "deflex",
    "tokenomics",
    "middleware",
    "first-stage"
  ],
  "author": "Moon Juice",
  "license": "MIT"
}
